# ========================================================
# Commity Unified Next.js Vercel Environment Variables
# ========================================================

# 1. API URL (Keep as /api for same-domain serverless routes)
NEXT_PUBLIC_API_URL=/api

# 2. Database (MongoDB Atlas Connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0

# 3. GitHub Personal Access Token (for rate limits & GraphQL)
GITHUB_TOKEN=ghp_your_github_token_here

# 4. Cron Secret (for protected sync triggers)
CRON_SECRET=your_random_secret_here
